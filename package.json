{
  "name": "crf-react-music-tools",
  "version": "0.1.0",
  "description": "A metronome and an instrument tuner as drop-in React components, with a precompiled stylesheet.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepperhorn/crf-react-music-tools.git"
  },
  "homepage": "https://github.com/pepperhorn/crf-react-music-tools#readme",
  "bugs": {
    "url": "https://github.com/pepperhorn/crf-react-music-tools/issues"
  },
  "keywords": [
    "react",
    "metronome",
    "tuner",
    "music",
    "web-audio",
    "pitch-detection"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metronome": {
      "types": "./dist/metronome/index.d.ts",
      "import": "./dist/metronome/index.js"
    },
    "./tuner": {
      "types": "./dist/tuner/index.d.ts",
      "import": "./dist/tuner/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./patterns.schema.json": "./dist/patterns.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts --host 0.0.0.0",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:demo": "vite build --config demo/vite.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
